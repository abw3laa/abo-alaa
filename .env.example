# ==========================================
# متجر Abo-alaa - نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ثم املأ القيم الحقيقية
# لا تضع هذا الملف بقيمه الحقيقية في Git
# ==========================================

# --- قاعدة البيانات (PostgreSQL) ---
# مثال محلي: postgresql://user:pass@localhost:5432/abo_alaa?schema=public
# للإنتاج استخدم مزودًا مثل Neon / Supabase / Railway
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abo_alaa?schema=public"
# رابط اتصال مباشر (بدون pooler) — يستخدمه Prisma Migrate أثناء البناء على Neon
# مثال Neon: استخدم نفس الرابط لكن بدون كلمة "-pooler" في اسم المضيف
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/abo_alaa?schema=public"

# --- Auth.js (NextAuth v5) ---
# ولّد المفتاح بأمر: npx auth secret
AUTH_SECRET="غيّر-هذا-إلى-قيمة-عشوائية-طويلة"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- إعدادات عامة للمتجر ---
NEXT_PUBLIC_SITE_NAME="Abo-alaa"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXT_PUBLIC_DEFAULT_CURRENCY="TRY"

# --- حساب المدير الأولي (يُستخدم في seed فقط) ---
# لا تترك هذه القيم الافتراضية في الإنتاج
SEED_ADMIN_EMAIL="admin@abo-alaa.com"
SEED_ADMIN_PASSWORD="ChangeMe_Strong#2026"
SEED_ADMIN_NAME="مدير المتجر"

# --- مزود الدفع (اختياري - يُستبدل Mock بمزود حقيقي) ---
# القيم الممكنة: mock | stripe | paypal
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- البريد الإلكتروني (اختياري) ---
# القيم الممكنة: mock | smtp
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Abo-alaa <no-reply@abo-alaa.com>"

# --- الرسائل النصية / واتساب (اختياري) ---
SMS_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"

# --- التخزين السحابي للصور (اختياري) ---
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# --- رفع الصور والفيديو عبر Vercel Blob ---
# فعّل Blob Storage من لوحة Vercel ثم أضف هذا التوكن
# مطلوب لكي يعمل رفع الصور/الفيديو من لوحة التحكم
BLOB_READ_WRITE_TOKEN=""

# --- التحليلات (اختياري) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Webhook مزوّد الدفع ---
# مسار الاستقبال: /api/webhooks/payment
# لـ Stripe: اضبط STRIPE_WEBHOOK_SECRET أعلاه

# --- Redis للكاش (اختياري) ---
REDIS_URL=""
